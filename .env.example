# =============================================================================
# CRM Imobiliário - Variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores.
# Nunca commite o .env (ele deve estar no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# Nome exibido na API (ex.: título no Swagger).
APP_NAME="Real Estate Attendance Backend"
# Ambiente: development | staging | production (afeta logs e comportamentos).
ENVIRONMENT=development
# Ativa modo debug (não use true em produção).
DEBUG=false

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Endereço em que o servidor escuta (0.0.0.0 permite acesso externo).
HOST=0.0.0.0
# Porta HTTP da API (ex.: 8000).
PORT=8000

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Connection string PostgreSQL. Ex.: Neon, Render, local.
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_attendance

# -----------------------------------------------------------------------------
# JWT (autenticação)
# -----------------------------------------------------------------------------
# Chave secreta para assinar e validar tokens. Use uma chave forte e única em produção.
JWT_SECRET_KEY=sua_chave_secreta_aqui
# Algoritmo do JWT (recomendado: HS256).
JWT_ALGORITHM=HS256
# Tempo de vida do token em horas (ex.: 24 = 1 dia).
JWT_EXPIRATION_HOURS=24

# -----------------------------------------------------------------------------
# Google OAuth (login com Google)
# -----------------------------------------------------------------------------
# Client ID do projeto no Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
# Client Secret do mesmo projeto OAuth 2.0.
GOOGLE_CLIENT_SECRET=
# URL de callback após login Google. Em produção use a URL do backend (ex.: Render).
# Local: http://localhost:8000/auth/google/callback
# Produção: https://seu-backend.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -----------------------------------------------------------------------------
# Google Maps (geocoding de endereços dos imóveis)
# -----------------------------------------------------------------------------
# Chave da API Google Maps (Geocoding API habilitada no projeto).
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Google Gemini (IA: resumos, chat, jornada do cliente)
# -----------------------------------------------------------------------------
# Chave da API Gemini (Google AI Studio ou Cloud).
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Cloudinary (upload de fotos dos imóveis)
# -----------------------------------------------------------------------------
# Nome do cloud (dashboard Cloudinary).
CLOUDINARY_CLOUD_NAME=
# API Key do Cloudinary.
CLOUDINARY_API_KEY=
# API Secret do Cloudinary.
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Frontend e CORS
# -----------------------------------------------------------------------------
# URL do frontend. Usada no fluxo OAuth (redirecionamento após login Google).
# Local: http://localhost:5173  |  Produção: https://frontend-astrocode.vercel.app
FRONTEND_URL=http://localhost:5173
# Origens permitidas pelo CORS (separadas por vírgula). O frontend deve estar aqui.
# Ex.: https://frontend-astrocode.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# SMTP (e-mail "Esqueci minha senha")
# -----------------------------------------------------------------------------
# Se não configurado, o link de redefinição é apenas logado no console (útil em dev).
# Host do servidor SMTP (ex.: smtp.gmail.com).
SMTP_HOST=
# Porta (geralmente 587 com TLS).
SMTP_PORT=587
# Usuário de autenticação SMTP.
SMTP_USER=
# Senha ou "App Password" (no Gmail, use senha de app).
SMTP_PASSWORD=
# E-mail remetente exibido ao usuário.
SMTP_FROM_EMAIL=noreply@example.com
# Usar TLS (true para Gmail e maioria dos provedores).
SMTP_USE_TLS=true
