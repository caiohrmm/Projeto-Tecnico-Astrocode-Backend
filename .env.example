# Application
APP_NAME="Real Estate Attendance Backend"
ENVIRONMENT=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_attendance

# SMTP (Esqueci minha senha) - opcional, veja docs/SMTP_CONFIGURATION.md
# Se não configurado, o link é logado no console (desenvolvimento)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_USE_TLS=true
